# Copy to .env.local and fill manually. Never commit .env.local.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER/earlybird
MONGODB_DB_NAME=earlybird_dev
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
AUTH_SESSION_DAYS=30
APP_ORG_ID=earlybird
BOOTSTRAP_OWNER_EMAIL=owner@example.com
BOOTSTRAP_OWNER_NAME=Owner
# Used by an external scheduler calling POST /api/jobs/reminders
JOB_RUNNER_SECRET=replace-with-a-different-long-random-secret
# Phase 4 onwards. Not required for enquiry or quotation work.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
