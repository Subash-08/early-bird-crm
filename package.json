{
  "name": "earlybird-travel-crm",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:phase5": "vitest run tests/settlement-domain.test.ts tests/settlement-flow.test.ts",
    "test:smoke": "tsx scripts/smoke-phase5.ts",
    "pdf:sample": "tsx scripts/render-sample-quote.ts",
    "pdf:finance-sample": "tsx scripts/render-sample-financial.ts",
    "pdf:operations-sample": "tsx scripts/render-sample-operations.ts",
    "db:setup": "tsx --env-file=.env.local scripts/setup.ts",
    "db:check": "tsx --env-file=.env.local scripts/check-db.ts",
    "db:seed-demo": "tsx --env-file=.env.local scripts/seed-demo.ts --confirm-demo",
    "production:check": "tsx --env-file=.env.local scripts/validate-production.ts",
    "owner:recover": "tsx --env-file=.env.local scripts/recover.ts",
    "worker": "tsx --env-file=.env.local scripts/worker.ts"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "better-auth": "1.7.14",
    "@better-auth/mongo-adapter": "1.7.14",
    "mongodb": "^6.21.0",
    "zod": "^4.3.6",
    "lucide-react": "^0.468.0",
    "exceljs": "^4.4.0",
    "csv-parse": "^6.1.0",
    "libphonenumber-js": "^1.12.0",
    "pdf-lib": "^1.17.1",
    "@pdf-lib/fontkit": "^1.1.1"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tsx": "^4.21.0",
    "vitest": "^3.2.4",
    "mongodb-memory-server": "^10.2.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "@playwright/test": "^1.56.0"
  }
}
